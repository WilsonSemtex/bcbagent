# ===== LLM 配置（DeepSeek 官方 API，仅 deepseek-v4-flash）=====
# API Key 从 DeepSeek 开放平台获取：https://platform.deepseek.com
LLM_API_KEY=sk-你的DeepSeek官方_APIKey
# API 基础地址（DeepSeek 官方，OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com/v1
# 默认使用的模型（deepseek-v4-flash 为推理模型，需要足够 max_tokens）
LLM_MODEL=deepseek-v4-flash

# DeepSeek 独立配置（deepseek-v4-flash 走此配置，与 LLM 配置相同即可）
DEEPSEEK_API_KEY=sk-你的DeepSeek官方_APIKey
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== Embedding 模型配置 =====
# Embedding 提供者：openai（智谱云端 embedding-3，向量检索优先）
EMBEDDING_PROVIDER=openai
# 云端 Embedding 模型名称（智谱 AI，需在 https://open.bigmodel.cn 获取 API Key）
EMBEDDING_MODEL=embedding-3
# Embedding 独立 API Key（智谱 AI key，格式为 {id}.{secret}，在 https://open.bigmodel.cn 获取；未设置则复用 LLM_API_KEY，但 DeepSeek key 无法调用 embedding-3）
EMBEDDING_API_KEY=你的智谱AI_APIKey
# Embedding API Base URL（显式指定智谱地址，避免回退到 LLM_BASE_URL）
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 视觉模型配置（图片分析，智谱 AI）=====
# 用户上传图片时自动调用此模型分析，分析结果交给主模型 DeepSeek 回答
VISION_MODEL=glm-4.6v-flash
VISION_API_KEY=你的智谱AI_APIKey
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 应用配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000

